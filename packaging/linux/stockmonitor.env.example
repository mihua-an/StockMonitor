# /etc/stockmonitor/stockmonitor.env -- read by both systemd units (Health and the web gateway).
# They must see the same values: the gateway reads the tokens Health writes and asks Health for its endpoints.
# Owner root, mode 0640, group stockmonitor.

# The Python environment built from requirements/linux/*.lock.
STOCK_MONITOR_PYTHON_EXECUTABLE=/opt/stockmonitor/.venv/bin/python
# The checkout is read-only for the service: no .pyc files are written into it.
PYTHONDONTWRITEBYTECODE=1

# Runtime data (market data, logs, settings) outside the checkout, so an update never touches it.
STOCK_MONITOR_VAR_ROOT=/var/lib/stockmonitor/var

# Base of the local IPC tokens (AUTH_ROOT = <this>/StockMonitorTwse/auth) and of the broker credential file
# (<this>/StockMonitorTwse/credentials/credentials.json, owner-only).
LOCALAPPDATA=/var/lib/stockmonitor/local

# The web gateway listens on loopback only; cloudflared on the same machine connects here.
STOCK_MONITOR_WEB_HOST=127.0.0.1
STOCK_MONITOR_WEB_PORT=8080

# Cloudflare Access (Zero Trust -> Access -> Applications -> your app):
#   team domain: <team>.cloudflareaccess.com (Settings -> Custom Pages / team domain)
#   AUD: the application's "Application Audience (AUD) Tag"
STOCK_MONITOR_WEB_CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com
STOCK_MONITOR_WEB_CF_AUD=replace-with-the-application-aud-tag
