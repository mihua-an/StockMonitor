{
  "schema": "stock-monitor-network-manifest-v2",
  "contract_version": 2,
  "spec": "docs/system-architecture/00_services_and_ports.md",
  "loopback_host": "127.0.0.1",
  "port_policy": {
    "min_port": 1024,
    "max_port": 65535,
    "reserved_ports": [8002, 8003, 8004, 8005, 8006, 8007, 8008, 8009]
  },
  "topology": "Managed services with an entry start in dependency order (depends_on and reads_addresses_at_start; ties in this file's order) and stop in reverse. A change of a service's address restarts every service that reads it at start (reads_addresses_at_start). self_handoff: moving this endpoint restarts Health itself (06 section 5). Health and settings_api derive every set from these fields: topology() in config/js/network_config.js and config/network_config.py.",
  "services": [
    {"service_id": "realtime_api", "kind": "api", "display_name": "即時 API", "default_port": 8000, "protocol": "http",
     "listener": true, "renderer_client": true, "managed": true, "process": "python",
     "entry": "api.services.realtime_api", "depends_on": ["market_runtime", "app_api"],
     "reads_addresses_at_start": ["market_runtime", "provider_shioaji", "provider_futu"],
     "parts": ["quote_api", "model_api"],
     "work": "即時報價頁的查詢、監控事件；模型設定／訓練管理、registry、唯一 AnalysisSignalProducer／LatestSignalStore"},
    {"service_id": "app_api", "kind": "api", "display_name": "頁面 API", "default_port": 8001, "protocol": "http+ws",
     "listener": true, "renderer_client": true, "managed": true, "process": "python",
     "entry": "api.services.app_api", "depends_on": [], "self_handoff": true,
     "reads_addresses_at_start": ["market_runtime", "provider_shioaji", "provider_futu"],
     "parts": ["settings_api", "history_api", "data_center_api", "actual_account_api", "paper_account_api"],
     "work": "共用設定與商品目錄、歷史查詢與回放、資料中心、實際帳務、模擬帳務"},
    {"service_id": "market_runtime", "kind": "runtime", "display_name": "即時行情（Rust A）", "default_port": 8010, "protocol": "ws",
     "listener": true, "renderer_client": true, "managed": true, "process": "rust",
     "entry": "market_runtime_daemon", "depends_on": [],
     "roles": ["viewer", "provider", "analysis_runtime", "signal_producer", "controller"],
     "work": "ingest、最新狀態、snapshot／delta、WAL、durable stream"},
    {"service_id": "service_controller", "kind": "controller", "display_name": "Health", "default_port": 8011, "protocol": "http",
     "listener": true, "managed": false, "process": "node",
     "entry": "health/main.js", "depends_on": [], "self_handoff": true,
     "work": "啟停、readiness、套用、恢復與監控彙整"},
    {"service_id": "provider_shioaji", "kind": "provider", "display_name": "Shioaji 來源", "default_port": 8100, "protocol": "http",
     "listener": true, "managed": true, "process": "python", "source": "shioaji",
     "entry": "backend.shioaji.run_shioaji_daemon", "depends_on": ["market_runtime"], "reads_addresses_at_start": ["market_runtime"],
     "work": "Shioaji SDK、來源能力、資料取得與實際訂閱"},
    {"service_id": "provider_futu", "kind": "provider", "display_name": "Futu 來源", "default_port": 8101, "protocol": "http",
     "listener": true, "managed": true, "process": "python", "source": "futu",
     "entry": "backend.futu.server", "depends_on": ["market_runtime", "external_futu_opend"],
     "reads_addresses_at_start": ["market_runtime", "external_futu_opend"],
     "work": "Futu SDK：US 股票＋CC 加密貨幣即時（CC 不存檔）；來源能力、資料取得與實際訂閱"},
    {"service_id": "external_futu_opend", "kind": "external", "display_name": "Futu OpenD（外部）", "default_port": 11111, "protocol": "tcp",
     "listener": false, "managed": false, "process": "external", "host_configurable": true,
     "work": "provider_futu 連接的 OpenD，不由本 App 任意停止"},
    {"service_id": "analysis_runtime", "kind": "runtime", "display_name": "累積計算（Rust B）", "default_port": null, "protocol": "ws-client+ipc",
     "listener": false, "managed": true, "process": "rust",
     "entry": "analysis_runtime", "depends_on": ["market_runtime"], "reads_addresses_at_start": ["market_runtime"],
     "work": "累積計算、事件、特徵、推論；獨立 PID"},
    {"service_id": "managed_workers", "kind": "worker", "display_name": "訓練／產製工作", "default_port": null, "protocol": "ipc",
     "listener": false, "managed": true, "process": "worker",
     "work": "有界背景工作，使用 job／worker ID"}
  ]
}
