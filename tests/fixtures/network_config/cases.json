{
  "schema": "network-config-cases-v1",
  "note": "Shared by tests/test_network_config.py and tests/network_config_parity_contract.cjs. Both resolvers must produce exactly these results.",
  "resolve": [
    {"name": "defaults: 6 own listeners",
     "saved": null, "env": {},
     "expect": {"listener_count": 6, "problem_codes": [],
                "ports": {"realtime_api": 8000, "app_api": 8001, "market_runtime": 8010, "service_controller": 8011,
                          "provider_shioaji": 8100, "provider_futu": 8101, "external_futu_opend": 11111,
                          "analysis_runtime": null}}},
    {"name": "saved revision moves one port",
     "saved": {"revision": 4, "values": {"services": {"realtime_api": {"port": 18000}}}}, "env": {},
     "expect": {"revision": 4, "problem_codes": [], "ports": {"realtime_api": 18000}, "sources": {"realtime_api": "saved", "app_api": "default"}}},
    {"name": "saved reserved port is refused and the default stays effective",
     "saved": {"revision": 2, "values": {"services": {"realtime_api": {"port": 8007}}}}, "env": {},
     "expect": {"problem_codes": ["PORT_RESERVED"], "ports": {"realtime_api": 8000}, "sources": {"realtime_api": "default"}}},
    {"name": "saved duplicate binding is refused",
     "saved": {"revision": 3, "values": {"services": {"app_api": {"port": 8000}}}}, "env": {},
     "expect": {"problem_codes": ["DUPLICATE_BINDING"], "ports": {"app_api": 8001, "realtime_api": 8000}}},
    {"name": "a swap inside one revision is legal",
     "saved": {"revision": 5, "values": {"services": {"realtime_api": {"port": 8001}, "app_api": {"port": 8000}}}}, "env": {},
     "expect": {"problem_codes": [], "ports": {"realtime_api": 8001, "app_api": 8000}}},
    {"name": "explicit start override is applied and recorded",
     "saved": null, "env": {"STOCK_MONITOR_PORT_OVERRIDES": "realtime_api=18000, market_runtime=18010"},
     "expect": {"problem_codes": [], "ports": {"realtime_api": 18000, "market_runtime": 18010},
                "sources": {"realtime_api": "override", "market_runtime": "override"}, "override_ids": ["market_runtime", "realtime_api"]}},
    {"name": "malformed overrides are reported, never applied",
     "saved": null, "env": {"STOCK_MONITOR_PORT_OVERRIDES": "realtime_api=abc,app_api,app_api=1_000"},
     "expect": {"problem_codes": ["OVERRIDE_SYNTAX", "PORT_NOT_INTEGER"], "ports": {"realtime_api": 8000, "app_api": 8001}}},
    {"name": "override colliding with a saved port is dropped",
     "saved": {"revision": 6, "values": {"services": {"realtime_api": {"port": 18000}}}},
     "env": {"STOCK_MONITOR_PORT_OVERRIDES": "app_api=18000"},
     "expect": {"problem_codes": ["DUPLICATE_BINDING"], "ports": {"realtime_api": 18000, "app_api": 8001}}},
    {"name": "a no-listener process cannot be given a port",
     "saved": {"revision": 1, "values": {"services": {"analysis_runtime": {"port": 8050}}}}, "env": {},
     "expect": {"problem_codes": ["NO_LISTENER"], "ports": {"analysis_runtime": null}}},
    {"name": "a saved revision with any bad entry is rejected whole (S2d-04): nothing of it applies, it is not the effective revision",
     "saved": {"revision": 1, "values": {"services": {"realtime_api": {"host": "0.0.0.0"}, "external_futu_opend": {"host": "192.168.1.5", "port": 11112}}}}, "env": {},
     "expect": {"problem_codes": ["HOST_NOT_ALLOWED"], "revision": null, "ports": {"external_futu_opend": 11111}, "hosts": {"realtime_api": "127.0.0.1", "external_futu_opend": "127.0.0.1"}}},
    {"name": "formal services stay on loopback; external OpenD host is configurable",
     "saved": {"revision": 1, "values": {"services": {"external_futu_opend": {"host": "192.168.1.5", "port": 11112}}}}, "env": {},
     "expect": {"problem_codes": [], "revision": 1, "ports": {"external_futu_opend": 11112}, "hosts": {"realtime_api": "127.0.0.1", "external_futu_opend": "192.168.1.5"}}},
    {"name": "out-of-range and non-integer ports",
     "saved": {"revision": 1, "values": {"services": {"realtime_api": {"port": 80}, "app_api": {"port": 70000}, "market_runtime": {"port": true}, "nope_api": {"port": 9000}}}}, "env": {},
     "expect": {"problem_codes": ["PORT_NOT_INTEGER", "PORT_OUT_OF_RANGE", "UNKNOWN_SERVICE"], "ports": {"realtime_api": 8000, "app_api": 8001, "market_runtime": 8010}}},
    {"name": "a saved revision without values.services is rejected, never read as no change",
     "saved": {"revision": 9, "values": {}}, "env": {},
     "expect": {"problem_codes": ["SAVED_REVISION_MALFORMED"], "revision": null, "sources": {"realtime_api": "default"}}},
    {"name": "a saved revision whose values.services is not an object is rejected",
     "saved": {"revision": 9, "values": {"services": "8000"}}, "env": {},
     "expect": {"problem_codes": ["SAVED_REVISION_MALFORMED"], "revision": null}},
    {"name": "a saved revision whose values is not an object is rejected",
     "saved": {"revision": 9, "values": "broken"}, "env": {},
     "expect": {"problem_codes": ["SAVED_REVISION_MALFORMED"], "revision": null}}
  ],
  "validate": [
    {"name": "valid multi-service reassignment",
     "values": {"realtime_api": {"port": 18000}, "app_api": {"port": 18001}}, "expect_codes": []},
    {"name": "duplicate against an untouched default",
     "values": {"realtime_api": {"port": 8001}}, "expect_codes": ["DUPLICATE_BINDING"]},
    {"name": "editing an unknown field",
     "values": {"realtime_api": {"port": 18000, "protocol": "https"}}, "expect_codes": ["UNKNOWN_FIELD"]},
    {"name": "reserved and external",
     "values": {"external_futu_opend": {"port": 8008}}, "expect_codes": []}
  ],
  "manifest": [
    {"name": "the shipped manifest", "edits": [], "expect": []},
    {"name": "default port out of range", "edits": [["realtime_api", "default_port", 80]], "expect": ["realtime_api: default_port 80 is outside 1024-65535"]},
    {"name": "default port reserved", "edits": [["app_api", "default_port", 8005]], "expect": ["app_api: default_port 8005 is reserved"]},
    {"name": "two defaults on one port", "edits": [["app_api", "default_port", 8000]], "expect": ["defaults: port 8000 is assigned to [\"app_api\",\"realtime_api\"]"]},
    {"name": "missing protocol, bad kind", "edits": [["provider_futu", "protocol", {"$delete": true}], ["provider_futu", "kind", "daemon"]], "expect": ["provider_futu: kind must be one of api, runtime, controller, provider, external, worker", "provider_futu: protocol must be a non-empty string"]},
    {"name": "listener flag as a string", "edits": [["market_runtime", "listener", "true"]], "expect": ["market_runtime: listener must be true or false", "market_runtime: a no-listener service must not declare a port", "market_runtime: renderer_client needs a listener speaking one of http, ws, http+ws"]},
    {"name": "unknown dependency", "edits": [["realtime_api", "depends_on", ["market_runtime", "quote_api"]]], "expect": ["realtime_api: depends_on names unknown service quote_api"]},
    {"name": "no-listener service with a port", "edits": [["analysis_runtime", "default_port", 8200]], "expect": ["analysis_runtime: a no-listener service must not declare a port"]},
    {"name": "policy and loopback", "edits": [["$", "loopback_host", "0.0.0.0"], ["$", "port_policy", {"min_port": 70000, "max_port": 1, "reserved_ports": "8002"}]], "expect": ["loopback_host must be one of 127.0.0.1, localhost, ::1", "port_policy: min_port and max_port must be integers with 1 <= min_port <= max_port <= 65535", "port_policy: reserved_ports must be a list of integers"]},
    {"name": "duplicate service id", "edits": [["provider_futu", "service_id", "provider_shioaji"]], "expect": ["duplicate service_id provider_shioaji"]},
    {"name": "renderer_client on a service without a listener", "edits": [["analysis_runtime", "renderer_client", true]], "expect": ["analysis_runtime: renderer_client needs a listener speaking one of http, ws, http+ws"]},
    {"name": "renderer_client on a tcp dependency", "edits": [["external_futu_opend", "renderer_client", true]], "expect": ["external_futu_opend: renderer_client needs a listener speaking one of http, ws, http+ws"]},
    {"name": "renderer_client not a boolean", "edits": [["app_api", "renderer_client", "yes"]], "expect": ["app_api: renderer_client must be true or false"]}
  ]
}
